# Operator environment for registry writes (`gnr create`) against the
# DEPLOYED registry. Copy to `operator.env` (gitignored), fill in, then in
# the shell you'll work from:
#
#     source operator.env
#
# The two secrets come from the team 1Password:
#   - "Grid Node Registry Write Proof" — the write Proof (authorizes
#     creating / re-parenting GNodes; the deployed registry holds only its
#     hash, GNR_WRITE_PROOF_SHA256)
#   - the hw1 broker credential for the AMQPS URL
#
# Without this file sourced, `gnr create` talks to the LOCAL rehearsal rig
# (.env), where hw1 aliases are refused by the universe gate — a safe miss.

export GNR_API_BASE=https://gnr.electricity.works
export GNR_RABBIT__URL='amqps://<user>:<pass>@hw1-1.electricity.works:5671/hw1__1'
export GNR_WRITE_PROOF='<the Grid Node Registry Write Proof>'
export SSL_CERT_FILE=$HOME/GridWorks/gridworks-infra/authority/ca.crt
