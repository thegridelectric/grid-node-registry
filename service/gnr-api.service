[Unit]
Description=Grid Node Registry — public read-only HTTP façade (loopback; Caddy fronts TLS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gnr
# Repo root as CWD so Settings' env_file=".env" resolves to the repo's .env.
WorkingDirectory=/home/gnr/grid-node-registry
ExecStart=/home/gnr/grid-node-registry/.venv/bin/gnr api
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
